{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "vitest.config.ts"],
  "tasks": {
    "build:run": {
      "dependsOn": ["^build:run"],
      "outputs": ["dist/**"]
    },
    "typecheck:run": {
      "dependsOn": ["^build:run"]
    },
    "test:run": {
      "dependsOn": ["^build:run"]
    },
    "dev:serve": {
      "dependsOn": ["^build:run"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "storage:ensure-bucket:run": {
      "dependsOn": ["^build:run"],
      "cache": false,
      "passThroughEnv": [
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_SESSION_TOKEN",
        "S3_FORCE_PATH_STYLE"
      ]
    },
    "ensure-database:run": {
      "dependsOn": ["^build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT"
      ]
    },
    "migrate:run": {
      "dependsOn": ["^build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT"
      ]
    },
    "migrate:status:run": {
      "dependsOn": ["^build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT"
      ]
    },
    "seed:run": {
      "dependsOn": ["^build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT"
      ]
    },
    "seed:demo:run": {
      "dependsOn": ["^build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT",
        "ALLOW_DEMO_SEED",
        "DEMO_USER_PASSWORD"
      ]
    },
    "bootstrap-admin:run": {
      "dependsOn": ["^build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT",
        "ADMIN_USERNAME",
        "ADMIN_PASSWORD",
        "ADMIN_DISPLAY_NAME"
      ]
    },
    "ensure-database:compiled:run": {
      "dependsOn": ["build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT"
      ]
    },
    "migrate:compiled:run": {
      "dependsOn": ["build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT"
      ]
    },
    "migrate:status:compiled:run": {
      "dependsOn": ["build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT"
      ]
    },
    "seed:compiled:run": {
      "dependsOn": ["build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT"
      ]
    },
    "seed:demo:compiled:run": {
      "dependsOn": ["build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT",
        "ALLOW_DEMO_SEED",
        "DEMO_USER_PASSWORD"
      ]
    },
    "bootstrap-admin:compiled:run": {
      "dependsOn": ["build:run"],
      "cache": false,
      "passThroughEnv": [
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_CONNECTION_LIMIT",
        "ADMIN_USERNAME",
        "ADMIN_PASSWORD",
        "ADMIN_DISPLAY_NAME"
      ]
    }
  }
}
