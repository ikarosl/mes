# HTTP 仅用于证书验证、容器内部健康检查及跳转，不接受明文业务请求。
# WEB_LISTEN_PORT 容器内部网络监听端口
server {
  listen ${WEB_LISTEN_PORT};
  server_name ${TLS_SERVER_NAME};

  # 外部80端口续期验证静态文件代理
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/acme;
    default_type text/plain;
    try_files $uri =404;
  }

  location = /api/health/live {
    allow 127.0.0.1;
    deny all;
    proxy_pass http://api:${API_PORT};
  }

  location / {
    return 308 https://${TLS_SERVER_NAME}:${HTTPS_PORT}$request_uri;
  }
}

server {
  listen 443 ssl;
  server_name ${TLS_SERVER_NAME};
  root /usr/share/nginx/html;

  # 挂载整个 Certbot 目录，保留 live/ 到 archive/ 的软链接和自动续期结果。
  ssl_certificate /etc/letsencrypt/live/easy-mes/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/easy-mes/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:TLS:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    client_max_body_size 21m;
    proxy_pass http://api:${API_PORT};
    proxy_set_header Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
