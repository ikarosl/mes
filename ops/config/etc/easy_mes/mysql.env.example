# 由于mysql配置文件变量名 是官方约定，所以单独文件，请保持与api.env中的配置一致。
# 请注意变量名与api.env 不一致，对应关系：
# MYSQL_DATABASE=DB_NAME、MYSQL_USER=DB_USER、MYSQL_PASSWORD=DB_PASSWORD
MYSQL_DATABASE=easy_mes
MYSQL_USER=mes
MYSQL_PASSWORD=replace-with-application-database-password
MYSQL_ROOT_PASSWORD=replace-with-root-database-password

