# 部署脚本将这些固定仓库与不可变摘要组合使用。

API_IMAGE_REPOSITORY=docker.io/your-docker-hub-user/easy-mes-api
WEB_IMAGE_REPOSITORY=docker.io/your-docker-hub-user/easy-mes-web

MYSQL_IMAGE=mysql:8.4
MINIO_IMAGE=quay.io/minio/aistor/minio:RELEASE.2026-04-14T21-32-45Z

HTTP_BIND_ADDRESS=0.0.0.0
# 对外暴露服务地址 api 服务由nginx 转发
HTTP_PORT=8091

# MySQL 客户端维护入口；安全组 TCP 入站仅允许维护电脑的公网 IP/32。
# 应用内部仍使用 api.env 中的 DB_HOST=mysql、DB_PORT=3306。
MYSQL_BIND_ADDRESS=0.0.0.0
MYSQL_PORT=13306

# MinIO 浏览器控制台；安全组 TCP 入站仅允许维护电脑的公网 IP/32。
# S3 API 保持容器内访问，api.env 中 S3_ENDPOINT 使用 http://minio:9000。
MINIO_CONSOLE_BIND_ADDRESS=0.0.0.0
MINIO_CONSOLE_PORT=19001
