NODE_ENV=production
# 生产监听端口统一在 deploy.env 的 API_PORT 配置，由 Compose 注入 APP_PORT。

DB_HOST=mysql
DB_PORT=3306
DB_USER=mes
DB_PASSWORD=replace-with-application-database-password
DB_NAME=easy_mes
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=easy-mes-next
JWT_AUDIENCE=easy-mes-admin
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_COOKIE_NAME=easy_mes_refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/auth
# 生产 Compose 固定注入 REFRESH_TOKEN_COOKIE_SECURE=true，不在这里重复设置。
TRUST_PROXY_HOPS=1

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mes-technical-files
S3_ACCESS_KEY_ID=replace-with-minio-user
S3_SECRET_ACCESS_KEY=replace-with-minio-password
S3_FORCE_PATH_STYLE=true

IDEMPOTENCY_SWEEP_INTERVAL_MS=3600000
