NODE_ENV=development
APP_PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=easy_mes
DB_CONNECTION_LIMIT=10
# TEST_DB_NAME：仅供真实 MySQL 集成测试使用（PowerShell：$env:RUN_MYSQL_INTEGRATION='1' 后执行
# pnpm test:production:mysql；Bash：RUN_MYSQL_INTEGRATION=1 pnpm test:production:mysql），
# 不属于常规运行配置。设置时必须与 DB_NAME 同时指向同一个以 `_test` 结尾的专用测试库
# （如 easy_mes_test / company_mes_next_test），校验规则见 scripts/assert-mysql-integration-enabled.mjs。

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=company-mes-next
JWT_AUDIENCE=company-mes-admin

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_COOKIE_PATH=/api/auth
REFRESH_TOKEN_COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_DISPLAY_NAME=系统管理员

# All technical files use the S3 protocol. Local development points to AIStor/MinIO.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mes-technical-files
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=12345678
# S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true

# 幂等（Idempotency）：到期清理定时器周期（毫秒），默认 1 小时（3600000）。
# 非法值（0/负数/非数字）时跳过自动清理，与 idempotency-housekeeping.service.ts 行为一致。
IDEMPOTENCY_SWEEP_INTERVAL_MS=3600000

TRUST_PROXY_HOPS=1
