NODE_ENV=development
APP_PORT=3000

DB_HOST=127.0.0.1
# 开发运行时连接 Windows 宿主机 MySQL。
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=easy_mes
DB_CONNECTION_LIMIT=10
# 真实 MySQL 集成测试配置，指向 WSL Docker 的宿主 3307 -> 容器 3306 映射。
# 执行测试时还必须显式设置 RUN_MYSQL_INTEGRATION=1，并临时将
# DB_HOST/DB_PORT/DB_NAME 设为与下列 TEST_DB_* 完全一致。库名必须以 `_test` 结尾。
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_NAME=easy_mes_test

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=company-mes-next
JWT_AUDIENCE=company-mes-admin

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_COOKIE_PATH=/api/auth
REFRESH_TOKEN_COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_DISPLAY_NAME=系统管理员

# All technical files use the S3 protocol. Local development points to AIStor/MinIO.
# 演示数据必须显式启用，不参与 db:init。仅在执行 pnpm db:seed:demo 时使用。
ALLOW_DEMO_SEED=0
DEMO_USER_PASSWORD=

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mes-technical-files
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=12345678
# S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true

# 幂等（Idempotency）：到期清理定时器周期（毫秒），默认 1 小时（3600000）。
# 非法值（0/负数/非数字）时跳过自动清理，与 idempotency-housekeeping.service.ts 行为一致。
IDEMPOTENCY_SWEEP_INTERVAL_MS=3600000

TRUST_PROXY_HOPS=1
