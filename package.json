{
  "name": "easy-mes-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.18.2 <11"
  },
  "scripts": {
    "dev": "turbo watch dev:serve",
    "dev:api": "turbo watch dev:serve --filter=@company/api",
    "dev:admin": "turbo watch dev:serve --filter=@company/admin-web",
    "build": "turbo run build:run",
    "typecheck": "turbo run typecheck:run",
    "typecheck:integration": "tsc -p tests/integration/tsconfig.json --noEmit",
    "test": "turbo run test:run",
    "test:production:mysql": "node scripts/assert-mysql-integration-enabled.mjs && turbo run build:run --filter=@company/api && corepack pnpm db:init && corepack pnpm db:seed && corepack pnpm exec vitest run --config tests/integration/vitest.mysql.config.ts",
    "lint": "eslint .",
    "docs:check": "node scripts/check-doc-links.mjs",
    "architecture:check": "node scripts/check-api-architecture.mjs",
    "workspace:tasks:check": "node scripts/check-workspace-task-dependencies.mjs",
    "migration:check": "node scripts/check-migration-readiness.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "release:changes": "node scripts/detect-release-changes.mjs",
    "release:changes:test": "node --test --experimental-test-isolation=none scripts/detect-release-changes.test.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "corepack pnpm run format:check && corepack pnpm run docs:check && corepack pnpm run architecture:check && corepack pnpm run workspace:tasks:check && corepack pnpm run migration:check && corepack pnpm run secrets:check && corepack pnpm run audit:prod && corepack pnpm run lint && corepack pnpm run build && corepack pnpm run typecheck && corepack pnpm run typecheck:integration && corepack pnpm run infra:license:test && corepack pnpm run test",
    "prepare": "husky",
    "precommit": "lint-staged",
    "db:ensure": "turbo run ensure-database:run --filter=@company/database",
    "db:migrate": "turbo run migrate:run --filter=@company/database",
    "db:migrate:status": "turbo run migrate:status:run --filter=@company/database",
    "db:seed": "turbo run seed:run --filter=@company/database",
    "db:seed:demo": "turbo run seed:demo:run --filter=@company/database",
    "db:init": "corepack pnpm db:ensure && corepack pnpm db:migrate && corepack pnpm db:seed && corepack pnpm db:bootstrap-admin",
    "test:migration:fresh": "corepack pnpm db:migrate && corepack pnpm db:migrate && corepack pnpm db:migrate:status",
    "db:bootstrap-admin": "turbo run bootstrap-admin:run --filter=@company/database",
    "storage:ensure-bucket": "turbo run storage:ensure-bucket:run --filter=@company/api",
    "infra:license:check": "node scripts/check-minio-license.mjs",
    "infra:license:test": "node --test scripts/check-minio-license.test.mjs",
    "infra:config": "docker compose --env-file .env -f infra/compose/compose.dev.yml config --quiet",
    "infra:up": "corepack pnpm infra:license:check && docker compose --env-file .env -f infra/compose/compose.dev.yml up -d mysql minio && corepack pnpm storage:ensure-bucket",
    "infra:init": "corepack pnpm infra:up && corepack pnpm db:init",
    "infra:down": "docker compose --env-file .env -f infra/compose/compose.dev.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/compose/compose.dev.yml logs -f mysql minio"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.2.0",
      "nanoid": "https://github.com/ai/nanoid/archive/refs/tags/3.3.18.tar.gz"
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,less,scss,html,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "turbo": "^2.10.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.4",
    "unplugin-swc": "^1.5.10",
    "vitest": "^3.2.7",
    "vue": "catalog:",
    "vue-tsc": "^2.1.10"
  }
}
